# =============================================================================
# ENVIRONMENT VARIABLES: Hostel Accommodation Registration System
# =============================================================================

# Frontend Supabase Configuration (Public Anon Key ONLY)
# Never expose the SUPABASE_SERVICE_ROLE_KEY to the browser!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Optional: Payment Gateway Public Key (for Razorpay client popup)
# Secret keys live exclusively in Supabase server secrets!
VITE_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER_KEY_ID

# Server-Side / Supabase Edge Functions Secrets (Set via: supabase secrets set KEY=VALUE)
# DEV_SIMULATE_PAYMENTS=true
# RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER_KEY_ID
# RAZORPAY_KEY_SECRET=your_server_only_razorpay_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
